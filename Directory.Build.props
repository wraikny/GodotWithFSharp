<Project>
  <!-- In a submodule, inherit the nearest enclosing repository's build settings. -->
  <PropertyGroup>
    <_GodotWithFSharpParentBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_GodotWithFSharpParentBuildProps>
  </PropertyGroup>
  <Import Project="$(_GodotWithFSharpParentBuildProps)" Condition="'$(_GodotWithFSharpParentBuildProps)' != ''" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GodotVersion Condition="'$(GodotVersion)' == ''">4.6.2</GodotVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
