<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>godot-fsharp-gen</ToolCommandName>
    <Description>Generate Godot C# nodes backed by F# implementations.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Definitions.fs" />
    <Compile Include="CSharpSyntax.fs" />
    <Compile Include="ExportDefaults.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="Metadata.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="Generator.fs" />
    <Compile Include="Program.fs" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
</Project>
