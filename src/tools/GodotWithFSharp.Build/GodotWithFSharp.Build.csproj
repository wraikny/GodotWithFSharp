<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Use the .NET 8 contract even when built by a newer SDK. The host supplies it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.8.3" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
</Project>
